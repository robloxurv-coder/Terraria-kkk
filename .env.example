# Endereço sem protocolo; substitua pelo servidor autorizado.
SERVER_HOST=127.0.0.1
SERVER_PORT=7782
CHARACTER_NAME=TerrariaBot

# Senha de entrada do servidor (não é senha de conta TShock).
SERVER_PASSWORD=

# classic ou journey; use journey somente em mundos Journey.
CHARACTER_MODE=classic

# Backoff 5s, 10s, 20s, 40s, 60s. Não reinicia ao entrar brevemente.
RECONNECT_DELAY_MS=5000
# Total máximo de reconexões por execução; 0 desativa.
MAX_RECONNECT_ATTEMPTS=5
# Erro de protocolo: espera ao menos 60s; no máximo 1 nova tentativa.
MAX_PROTOCOL_RECONNECT_ATTEMPTS=1
# Kick/recusa explícita do servidor encerra sem reconectar.
# Não use supervisor com reinício infinito: ele anularia estes limites.
